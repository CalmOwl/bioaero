---
import films from "../../raw-screenings.json";

const now = new Date();
const currentMonth = now.getMonth() + 1;
const daysInCurrentMonth = new Date(
  now.getFullYear(),
  now.getMonth() + 1,
  0,
).getDate();

const firstDayOfMonth = new Date(`2026-${currentMonth}-1`);
const firstDay = firstDayOfMonth.getDay();

const getMonthCalendar = (days: number) => {
  let result = new Array(firstDay !== 0 ? firstDay - 1 : 6).fill("");

  for (let i = 1; i <= days; i++) {
    result.push(
      `2026-${currentMonth < 10 ? `0${currentMonth}` : currentMonth}-${i < 10 ? `0${i}` : i}`,
    );
  }
  return result;
};

const dates = getMonthCalendar(daysInCurrentMonth);

const getDataScreeningsIds = () => {
  let result: { date: string; screeningIds: string[] }[] = [];

  for (let i = 0; i < dates.length; i++) {
    if (dates[i] === "") {
      continue;
    }

    for (let j = 0; j < films.length; j++) {
      if (films[j].start.includes(dates[i])) {
        if (result.length == 0 || !result.some((x) => x.date === dates[i])) {
          result.push({ date: dates[i], screeningIds: [films[j].id] });
        } else if (result.some((x) => x.date === dates[i])) {
          const dateElem = result.find((x) => x.date === dates[i]);

          if (!dateElem?.screeningIds.includes(films[j].id)) {
            dateElem?.screeningIds.push(films[j].id);
          }
        }
      }
    }
  }

  return result;
};

const screeningDates = getDataScreeningsIds();

const enrichDates = (
  datesArr: string[],
  screeningsArr: { date: string; screeningIds: string[] }[],
) => {
  let result: { date: string; screeningIds: string[] }[] = [];

  for (let date of datesArr) {
    result.push({ date: date, screeningIds: [] });

    if (screeningsArr.some((x) => x.date == date)) {
      const dateElem = result.find((x) => x.date === date);
      const screeningsElem = screeningsArr.find((x) => x.date == date);

      if (screeningsElem?.screeningIds) {
        dateElem?.screeningIds.push(screeningsElem.screeningIds.join(","));
      }
    }
  }

  return result;
};

const DAYS = enrichDates(dates, screeningDates);

let emptyCellsCount = 0;

DAYS.map((day) => {
  if (day.date == "") {
    emptyCellsCount++;
  }
});
---

<div class="calendar">
  {
    DAYS.map((day, index) => {
      return day.date !== "" ? (
        <button
          class="calendar_cell"
          data-date={day.date}
          data-screening-ids={day.screeningIds}
        >
          {index - emptyCellsCount + 1}
        </button>
      ) : (
        <div class="calendar_cell calendar_cell--empty" aria-hidden="true" />
      );
    })
  }
</div>

<style>
  .calendar {
    border: 3px solid var(--color-accent);
    border-radius: calc(1rem + 12px);
    padding: 16px;
    margin: 0px auto;
    width: max-content;
    display: grid;
    grid-template-columns: repeat(7, 3rem);
    gap: 4px;
    justify-content: center;

    @media (max-width: 505px) {
      grid-template-columns: repeat(7, 2rem);
    }
  }

  .calendar .calendar_cell {
    display: flex;
    border: 2px solid var(--color-accent);
    border-radius: 8px;
    height: auto;
    font-size: 1.5rem;
    aspect-ratio: 1/1;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-dark);

    @media (max-width: 505px) {
      grid-template-columns: repeat(7, 2rem);
      font-size: 1rem;
    }

    @media (hover: hover) {
      &:hover {
        background-color: var(--color-accent-dark);
        color: var(--color-white);
      }

      @media (prefers-color-scheme: dark) {
        &:hover {
          background-color: var(--color-white);
          color: var(--color-accent-dark);
        }
      }
    }

    &:disabled {
      border-color: transparent;
      cursor: default;
      pointer-events: none;
    }

    @media (prefers-color-scheme: dark) {
      color: var(--color-white);
      background-color: var(--color-accent-dark);
    }
  }

  .calendar .calendar_cell--empty {
    border: transparent;
    background-color: transparent;
    cursor: default;
    pointer-events: none;
  }

  .calendar .calendar_cell--today {
    font-weight: 600;
    background-color: var(--color-accent);
    color: var(--color-white);

    @media (prefers-color-scheme: dark) {
      background-color: var(--color-accent);
      color: var(--color-accent-dark);
    }
  }

  .calendar .calendar_cell.active {
    transform: rotate(5deg) scale(1.3);
    background-color: revert;
    color: revert;
    font-weight: 500;
  }
</style>

<script>
  const rightNow = new Date();
  const date = rightNow.getDate().toString();

  let calendarCells =
    document.querySelectorAll<HTMLButtonElement>(".calendar_cell");

  function getList(element: HTMLElement, dataAttribute: string) {
    const arr = element.dataset[dataAttribute]?.split(",");
    if (arr?.length == 1 && arr[0] == "") return;
    return arr;
  }

  function updateContainerVisibility() {
    const container = document.querySelector(".gridview_container");
    const films = document.querySelectorAll<HTMLButtonElement>(".film-button");

    const allInvisible = [...films].every((element) =>
      element.classList.contains("invisible"),
    );
    console.log(allInvisible);

    container?.classList.toggle("invisible", allInvisible);
  }

  for (let cell of calendarCells) {
    if (cell.textContent.trim() == date) {
      cell.classList.add("calendar_cell--today");
    }
    if (cell.tagName === "BUTTON") {
      const cellScreeningIds = getList(cell, "screeningIds");
      if (!cellScreeningIds || cellScreeningIds.length == 0) {
        cell.disabled = true;
        continue;
      }
      cell.addEventListener("click", () => {
        // cell.dataset.date - если надо показать где-то

        //cell.dataset.screeningIds.split(",") -
        document.querySelector(".active")?.classList.remove("active");
        cell.classList.add("active");

        const films = document.querySelectorAll<HTMLElement>(".film"); // data-scr-ids
        const filmButtons =
          document.querySelectorAll<HTMLElement>(".film-button"); // data-scr-ids

        const screenings =
          document.querySelectorAll<HTMLElement>(".film-screening li"); // data-scr-id

        for (let screening of screenings) {
          const hasScreening = cellScreeningIds.includes(
            screening.dataset.screeningId!,
          );
          screening.classList.toggle("invisible", !hasScreening);
          // if (
          //   !cell.dataset.screeningIds.includes(screening.dataset.screeningId)
          // ) {
          //   screening.classList.toggle("invisible");
          // }
        }

        for (let film of films) {
          const filmScreeningIds = getList(film, "screeningIds");
          if (!filmScreeningIds) {
            film.classList.toggle("invisible", true);
            continue;
          }
          const hasScreenings = filmScreeningIds.some((x) =>
            cellScreeningIds.includes(x),
          );

          film.classList.toggle("invisible", !hasScreenings);
          // if (
          //   !film.dataset.screeningIds.some((x) =>
          //     cell.dataset.screeningIds.includes(x),
          //   )
          // ) {
          //   film.classList.toggle("invisible");
          // }
        }

        for (let film of filmButtons) {
          const filmScreeningIds = getList(film, "screeningIds");
          if (!filmScreeningIds) {
            film.classList.toggle("invisible", true);
            continue;
          }
          const hasScreenings = filmScreeningIds.some((x) =>
            cellScreeningIds.includes(x),
          );

          film.classList.toggle("invisible", !hasScreenings);
        }
        updateContainerVisibility();
      });
    }
  }
</script>
