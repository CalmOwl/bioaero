---
import { FILMS } from "../filmdata";
import pluralize from "../scripts/pluralize";
import ScreeningsCalendar from "../components/ScreeningsCalendar.astro";

const filmsNumber = FILMS.length;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Когда-куда?</title>
    <meta property="og:url" content="https://calmowl.github.io/bioaero/" />
    <meta property="og:title" content="Когда-куда?" />
    <meta property="og:image" content="/bioaero/favicon/apple-touch-icon.png" />
    <meta
      property="og:image:alt"
      content="Билет голубого цвета с изображением кадра посередине"
    />
    <meta
      property="og:description"
      content="Выбираем, где и когда молча посидим вместе пару часов"
    />
    <meta property="og:locale" content="ru" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="/bioaero/style.css" rel="stylesheet" />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/bioaero/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/bioaero/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/bioaero/favicon/favicon-16x16.png"
    />
    <link rel="icon" href="/bioaero/favicon/favicon.ico" />
    <link rel="manifest" href="/bioaero/favicon/site.webmanifest" />
  </head>

  <body>
    <div class="page-wrapper">
      <header>
        <a href="/bioaero" class="header_title">
          <img
            class="header-logo"
            src="/bioaero/ticket.png"
            alt="Билет голубого цвета с изображением кадра посередине"
          />
          Когда-куда?
        </a>
        <div class="header_wrapper">
          <div class="header_info">
            <p>
              Сегодня <span class="todayDate"></span>,
            </p>
            <p>в афише {filmsNumber} {pluralize(filmsNumber)}</p>
          </div>
          <a href="/bioaero/personal-plan" class="header_favourites">
            <span class="favourites__icon"></span>
            Мои сеансы
          </a>
        </div>
      </header>

      <button class="calendar-toggle" type="button"> Выбрать дату </button>
      <div class="view-container">
        <a class="gridview" href="/bioaero/gridview"> В виде постеров </a>
        <a class="listview" href="/bioaero/"> В виде карточек </a>
        <button class="suggestions" type="button">Хочу совет!</button>
      </div>
      <div class="calendar-overlay"></div>
      <aside>
        <button
          class="calendar-close"
          type="button"
          aria-label="Закрыть календарь"
        >
          ×
        </button>
        <ScreeningsCalendar />
      </aside>
      <main>
        <slot />
        <a href="#" class="page-up-button">
          <span class="page-up-button__icon visually-hidden">
            Вернуться к началу страницы
          </span>
          <span class="page-up-button__icon"></span>
        </a>
      </main>
      <footer>
        <a class="footer-link" href="https://t.me/ahojbiograf"
          ><span class="footer-telegram"></span>choose wisely</a
        >
        <a
          class="footer-credits"
          href="https://www.flaticon.com/free-icons/movie-tickets"
          title="movie tickets icons"
          >Movie tickets icons created by Freepik - Flaticon</a
        >
      </footer>
    </div>
  </body>
</html>

<style>
  .page-up-button {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    @media (prefers-reduced-motion: no-preference) {
      transition:
        opacity 300ms ease,
        visibility 300ms ease;
    }
  }

  .page-up-button.is-visible {
    opacity: 0.5;
    visibility: visible;
    pointer-events: auto;
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);

    @media (hover: hover) {
      &:hover {
        opacity: 1;
      }
    }

    @media (max-width: 560px) {
      bottom: 10px;
      right: 10px;
    }
  }

  .page-up-button__icon {
    display: block;
    width: 26px;
    height: 26px;
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
    mask-image: url("/bioaero/svg/arrow-circle-up.svg");
    background-color: var(--color-accent);
  }

  header,
  footer {
    flex-grow: 0;
    flex-shrink: 0;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    @media (max-width: 560px) {
      flex-direction: column;
      align-items: normal;
      margin: 0.5rem 0;
      gap: 0.7rem;
    }
  }

  header a {
    &:focus-visible {
      color: var(--color-accent);

      @media (prefers-color-scheme: dark) {
        color: var(--color-white);
      }
    }

    &:active {
      color: var(--color-accent);
    }

    @media (hover: hover) {
      &:hover {
        color: var(--color-accent);

        @media (prefers-color-scheme: dark) {
          color: var(--color-white);
        }
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      transition: 300ms;
    }
  }

  .header_title {
    display: flex;
    align-items: center;
    margin: 0;
  }

  .header-logo {
    width: 64px;
    height: 64px;

    .header_title:focus-visible & {
      transform: translateX(16px) translateY(-16px) rotate(45deg);
    }

    @media (max-width: 560px) {
      margin-left: -10px;
    }

    @media (hover: hover) {
      .header_title:hover & {
        transform: translateX(16px) translateY(-16px) rotate(45deg);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      transition: 300ms;
      animation: drop-in 1000ms;
    }
  }

  .header_wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    align-items: end;

    @media (max-width: 560px) {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .header_wrapper * {
    margin: 0;
  }

  .header_info {
    display: flex;
    gap: 0.3ch;

    @media (max-width: 560px) {
      display: revert;
    }
  }

  .header_info * {
    font-size: 1.3rem;
    font-weight: 500;
    text-align: end;

    @media (max-width: 560px) {
      margin: 0;
      font-size: 1rem;
      text-align: revert;
    }
  }

  .header_favourites {
    font-size: 1.5rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;

    @media (max-width: 560px) {
      font-size: 1rem;
    }
  }

  .favourites__icon {
    display: block;
    width: 26px;
    height: 26px;
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
    mask-image: url("/bioaero/svg/favourites.svg");
    background-color: var(--color-black);

    @media (prefers-color-scheme: dark) {
      background-color: var(--color-grey);
    }

    header a:focus-visible & {
      transform: rotateY(360deg);
      background-color: var(--color-accent);

      @media (prefers-color-scheme: dark) {
        background-color: var(--color-white);
      }
    }

    @media (hover: hover) {
      header a:hover & {
        transform: rotateY(360deg);
        background-color: var(--color-accent);

        @media (prefers-color-scheme: dark) {
          background-color: var(--color-white);
        }
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      transition: 300ms;
    }
  }

  aside {
    display: none;

    @media (min-width: 1840px) {
      display: block;
      position: fixed;
      top: 15%;
      left: calc((100vw - 960px) / 2 - 432px);
    }
  }

  .calendar-toggle,
  .calendar-close,
  .calendar-overlay {
    display: none;
  }

  @media (max-width: 1839px) {
    .calendar-toggle {
      display: block;
      border: none;
      display: flex;
      gap: 8px;
      align-items: center;
      justify-content: center;
      max-width: 100%;
      border-radius: 1rem;
      padding: 0.5rem;
      background-color: var(--color-accent);
      flex-shrink: 0;

      @media (hover: hover) {
        &:hover {
          background-color: var(--color-accent-dark);
          color: var(--color-white);
        }
      }

      @media (prefers-reduced-motion: no-preference) {
        transition: 500ms;
      }

      .calendar-toggle:focus-visible {
        background-color: var(--color-accent-dark);
        color: var(--color-white);
      }

      .calendar-toggle:has(.is-active) {
        background-color: var(--color-white);
      }
    }

    aside {
      display: block;
      position: fixed;
      z-index: 1000;
      top: 0;
      left: 0;
      width: min(450px, 90vw);
      height: 100dvh;
      padding: 1.5rem;
      background-color: var(--color-black);
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
    }

    aside.open {
      transform: translateX(0);
    }

    .calendar-close {
      display: block;
      font-size: 2rem;
      border: none;
      border-radius: 50%;
      width: 3rem;
      height: 3rem;
      margin-bottom: 1rem;
    }

    .calendar-overlay {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 999;
      background: rgb(0 0 0 / 50%);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .calendar-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .view-container {
    font-size: 1.5rem;
    color: var(--color-accent);
    display: grid;
    grid-template-columns: 1.44fr 1.42fr 1fr;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 0.7rem;

    @media (prefers-color-scheme: dark) {
      color: var(--color-white);
    }

    @media (max-width: 505px) {
      font-size: 1rem;
    }
  }

  .view-container a,
  .suggestions {
    color: inherit;
    text-decoration: none;

    text-align: center;

    @media (hover: hover) {
      &:hover {
        color: var(--color-white);

        @media (prefers-color-scheme: dark) {
          color: var(--color-accent);
        }
      }
    }
  }

  .suggestions {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
  }
</style>

<script>
  const button = document.querySelector(".page-up-button");

  if (button instanceof HTMLElement) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > window.innerHeight) {
        button.classList.add("is-visible");
      } else {
        button.classList.remove("is-visible");
      }
    });
  }

  const date = new Date();

  (document.querySelector(".todayDate") as HTMLElement).textContent =
    date.toLocaleDateString("ru-RU", {
      weekday: "short",
      day: "numeric",
      month: "2-digit",
    });

  const calendarToggle =
    document.querySelector<HTMLButtonElement>(".calendar-toggle");

  const calendarClose =
    document.querySelector<HTMLButtonElement>(".calendar-close");

  const calendarOverlay =
    document.querySelector<HTMLElement>(".calendar-overlay");

  const aside = document.querySelector<HTMLElement>("aside");

  const openCalendar = () => {
    aside?.classList.add("open");
    calendarOverlay?.classList.add("open");
  };

  const closeCalendar = () => {
    aside?.classList.remove("open");
    calendarOverlay?.classList.remove("open");
  };

  calendarToggle?.addEventListener("click", openCalendar);
  calendarClose?.addEventListener("click", closeCalendar);
  calendarOverlay?.addEventListener("click", closeCalendar);

  const suggestionsButton = document.querySelector(".suggestions");

  suggestionsButton?.addEventListener("click", () => {
    const films = document.querySelectorAll<HTMLElement>(".film");
    const filmButtons = document.querySelectorAll<HTMLElement>(".film-button");

    for (let film of films) {
      if (!film.dataset.suggestion) {
        film.classList.toggle("invisible", true);
        continue;
      }
    }
    for (let film of filmButtons) {
      if (!film.dataset.suggestion) {
        film.classList.toggle("invisible", true);
        continue;
      }
    }
  });
</script>
